#netperf custom
apt-get update
apt-get remove netperf -y
apt-get purge netperf -y
apt-get autoremove -y

apt-get install make git wget build-essential autoconf libtool gcc-9 g++-9 -y
git clone https://github.com/sejjong/netperf_custom2.git


cd netperf_custom2
./configure
wget https://git.savannah.gnu.org/cgit/config.git/plain/config.guess -O config.guess
wget https://git.savannah.gnu.org/cgit/config.git/plain/config.sub -O config.sub
./configure
make
